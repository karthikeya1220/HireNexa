# AI + AWS (SERVER-ONLY — never use the NEXT_PUBLIC_ prefix on these, or the
# keys get bundled into the browser build)
GEMINI_API_KEY=your_gemini_api_key
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
S3_BUCKET_NAME=your_s3_bucket_name

# Allowed browser origins for the API (comma-separated).
# Leave empty in development to allow http://localhost:3000 only.
CORS_ORIGINS=https://yourdomain.com

# Backend server config
PORT=5001

# Supabase (backend) — Project Settings > API
# SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY: service-role client used by the
# Express API for every query (bypasses RLS; never shipped to the browser).
# Bearer tokens are verified against the project JWKS discovered from
# SUPABASE_URL (asymmetric ES256) — no shared secret required.
# SUPABASE_JWT_SECRET is optional; only read for legacy HS256-signed projects.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# SUPABASE_JWT_SECRET=your_legacy_hs256_jwt_secret

# Supabase (frontend) — safe to expose; the browser uses these ONLY for
# magic-link auth. The browser never queries PostgREST directly (all data
# access goes through the Express API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Frontend API URL (if deploying backend separately)
NEXT_PUBLIC_API_URL=http://localhost:5001/api

# Per-user daily budget for AI endpoints (Gemini), 24h rolling window.
# In-memory: resets on server restart. Default 50 if unset.
AI_DAILY_QUOTA=50
