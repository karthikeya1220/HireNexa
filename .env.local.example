# Supabase (frontend) — safe to expose; used ONLY for magic-link auth in the
# browser. The browser never queries PostgREST directly (all data access goes
# through the Express API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# AWS S3 + Gemini + backend Supabase keys live in .env (server-only — those
# must never use the NEXT_PUBLIC_ prefix; see .env.example).

# Backend API URL (default is http://localhost:5001/api)
NEXT_PUBLIC_API_URL=http://localhost:5001/api
